# Copy to apps/api/.env for local work. Never commit real values.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
# Pooled URL for baton_app (FastAPI). Local default shown.
DATABASE_URL=postgresql+psycopg://baton_app:app@localhost:5432/baton
# Direct URL for baton_migrator. GitHub Actions only outside local.
DATABASE_URL_DIRECT=postgresql+psycopg://baton_migrator:migrator@localhost:5432/baton
ALLOWED_EMAIL_DOMAINS=example.edu
LOGIN_CODE_PEPPER=
RATE_LIMIT_PEPPER=
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
IMAGE_BASE_URL=
NEXT_PUBLIC_IMAGE_BASE_URL=
